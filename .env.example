# Banco de Dados
MYSQL_HOST="mysql"
MYSQL_PORT="3306"
MYSQL_USER="webhookflow_user"
MYSQL_PASSWORD="altere_esta_senha"
MYSQL_DATABASE="webhookflow"
MYSQL_ROOT_PASSWORD="altere_a_senha_root"

# RabbitMQ
RABBITMQ_HOST="rabbitmq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="webhookflow"
RABBITMQ_PASSWORD="altere_esta_senha"

# Criptografia

# Chave hexadecimal de 32 bytes utilizada no fluxo de descriptografia AES-256-CBC.

# Substitua por uma chave válida em ambientes reais.

GRUMMER_SECRET_KEY="substitua_por_uma_chave_hexadecimal_valida"

# Distribuidor SMS

# Endpoint mock interno utilizado pelo Docker Compose.

SMS_WEBHOOK_URL="http://api:8000/mock/sms"

# Endpoint externo opcional.

# SMS_WEBHOOK_URL="https://seu-endpoint-webhook.com"

# Simulação de Falhas

# 0.10 = 10% de falha aleatória

# 1.00 = 100% de falha para validação de Retry + DLQ

SMS_FAILURE_RATE=0.10

# SMS_FAILURE_RATE=1.00
